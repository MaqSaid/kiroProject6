{
  "enabled": true,
  "name": "Type Check After Task",
  "description": "Runs mypy type checking after each spec task completes to ensure type safety",
  "version": "1",
  "when": {
    "type": "postTaskExecution"
  },
  "then": {
    "type": "runCommand",
    "command": "mypy src/ --ignore-missing-imports",
    "timeout": 60
  }
}