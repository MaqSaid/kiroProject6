{
  "enabled": true,
  "name": "Python Lint on Save",
  "description": "Runs ruff check with auto-fix on Python files when they are edited, ensuring consistent code style",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "**/*.py"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "cd c:\\Users\\Saram\\kiroProject6 && python -m ruff check --fix --quiet ${file}",
    "timeout": 15
  }
}