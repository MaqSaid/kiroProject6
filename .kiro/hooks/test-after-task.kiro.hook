{
  "enabled": true,
  "name": "Run Tests After Task",
  "description": "Runs the full test suite (unit, property, and integration tests) after each task execution to verify no regressions were introduced",
  "version": "1",
  "when": {
    "type": "postTaskExecution"
  },
  "then": {
    "type": "runCommand",
    "command": "cd c:\\Users\\Saram\\kiroProject6 && python -m pytest tests/property/ tests/unit/ tests/integration/ --ignore=tests/unit/domain/processing/test_normalizers.py -x -q --tb=line 2>&1 | Select-Object -Last 5",
    "timeout": 120
  }
}
