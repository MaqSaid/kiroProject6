{
  "enabled": true,
  "name": "Run Tests After Task",
  "description": "After completing a spec task, run relevant unit tests to verify the implementation works before moving to the next task",
  "version": "1",
  "when": {
    "type": "postTaskExecution"
  },
  "then": {
    "type": "runCommand",
    "command": "python -m pytest tests/ -x -q --tb=short --timeout=30 2>&1 | head -50"
  }
}