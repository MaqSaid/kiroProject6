{
  "enabled": true,
  "name": "Dockerfile Best Practices",
  "description": "Validates that Dockerfile changes follow multi-stage build, non-root user, and health check conventions",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "**/Dockerfile",
      "**/Dockerfile.*"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Review the edited Dockerfile and verify: uses multi-stage build, runs as non-root user, has HEALTHCHECK instruction, pins base image versions (no :latest), copies only required files (not entire context), uses .dockerignore patterns."
  }
}