# =============================================================================
# Legislation RAG Platform - Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# --- Neo4j Configuration ---
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_DATABASE=neo4j

# --- AWS Configuration (for Embedding Service / Bedrock) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=amazon.titan-embed-text-v2:0

# --- API Gateway Configuration ---
# Comma-separated list of valid API keys
API_KEYS=dev-api-key
# Max requests per minute per API key
RATE_LIMIT_PER_MINUTE=60
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Logging ---
# Log level for all services (debug, info, warning, error)
LOG_LEVEL=info

# --- Observability (optional) ---
# OpenTelemetry collector endpoint (leave empty to disable tracing)
OTLP_ENDPOINT=
