# =============================================================================
# RAG Pipeline Agents - Configuration
# =============================================================================
# Copy this file to .env in project root, or set these environment variables
# before running the agents.
#
# Usage:
#   Option 1: Copy to .env (if using python-dotenv)
#   Option 2: Run in terminal:
#     Windows CMD:  for /F "tokens=*" %i in (src\agents\config.env) do set %i
#     PowerShell:   Get-Content src\agents\config.env | ForEach { if($_ -match "^[^#]") { $var=$_.Split("=",2); [Environment]::SetEnvironmentVariable($var[0],$var[1]) } }
# =============================================================================

# --- AWS Region ---
# Bedrock model availability varies by region.
# us-east-1 and us-west-2 have the widest model selection.
AWS_REGION=us-east-1
RAG_AGENT_REGION=us-east-1

# --- Model Tier (controls which model all agents use by default) ---
# Options: lite, pro, premium
#   lite    = Amazon Nova Lite    (~$0.06/$0.24 per 1M tokens) - cheapest
#   pro     = Amazon Nova Pro     (~$0.80/$3.20 per 1M tokens) - balanced
#   premium = Claude Sonnet 4     (~$3.00/$15.00 per 1M tokens) - best quality
RAG_AGENT_TIER=lite

# --- Override: Use a specific model for ALL agents (takes precedence over tier) ---
# Uncomment to force a specific model:
# RAG_AGENT_MODEL_ID=us.amazon.nova-lite-v1:0
# RAG_AGENT_MODEL_ID=us.amazon.nova-pro-v1:0
# RAG_AGENT_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0

# --- Per-Agent Tier Overrides ---
# Override the tier for specific agents without changing the global default.
# Useful for giving the generation agent a smarter model while keeping others cheap.
# RAG_RETRIEVAL_TIER=lite
# RAG_GENERATION_TIER=pro
# RAG_CITATION_VERIFICATION_TIER=lite
# RAG_INGESTION_TIER=lite
# RAG_EVALUATION_TIER=pro

# --- Model Parameters ---
RAG_AGENT_TEMPERATURE=0.1
RAG_AGENT_MAX_TOKENS=4096
